# TeamTab Environment Configuration - ROAD TO DEVCON - IIITN EDITION

# Ethereum RPC URL (Default: Sepolia Testnet)
NEXT_PUBLIC_RPC_URL=https://rpc.sepolia.org
NEXT_PUBLIC_CHAIN_ID=11155111

# Optional ERC-4337 Bundler & Paymaster (e.g. Pimlico, Biconomy, Alchemy, or ZeroDev)
# TeamTab runs out of the box with zero setup in Live Testnet / Interactive Sandbox mode!
NEXT_PUBLIC_BUNDLER_RPC_URL=https://api.pimlico.io/v2/sepolia/rpc?apikey=YOUR_PIMLICO_API_KEY
NEXT_PUBLIC_PAYMASTER_RPC_URL=https://api.pimlico.io/v2/sepolia/rpc?apikey=YOUR_PIMLICO_API_KEY

# Deployed Smart Contract (Optional override - pre-configured default included)
NEXT_PUBLIC_VAULT_FACTORY_ADDRESS=0x38bDF8a12345678901234567890123456789aBCd
NEXT_PUBLIC_ENTRYPOINT_ADDRESS=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789

# WalletConnect Project ID (Optional - for mobile wallet connections)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=demo_walletconnect_id_teamtab
